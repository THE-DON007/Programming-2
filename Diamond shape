#include<iostream>
using namespace std; 

//function to draw diamond
void drawDiamond(int size){
	//Upper half including middle row
	for(int i=1; i<=size; i++){
		//Print spaces
		for(int j=i; j<size; j++){
			cout<<" ";
		}
		//Pritn stars
		for(int k=1; k<=(2*i-1); k++){
			cout<<"*";
		}
		cout<<endl;
	}
	//Lower half
	for(int i=size-1; i>=1; i--){
		//Print spaces
		for(int j=size; j>i; j--){
			cout<<" ";
		}
		//Print stars
		for(int k=1; k<=(2*i-1); k++){
			cout<<"*";
		}
		cout<<endl;
	}
}
int main(){
	int size;
	cout<<"Enter the size of the diamond: ";
	cin>>size;
	drawDiamond(size);
	
	return 0;

}
